---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SKOOL_URL } from '../consts';

const stats = [
  { v: '3,217', label: 'Members', amber: true },
  { v: '142', label: 'Labs run to date' },
  { v: '3', label: 'Skills shipped so far' },
  { v: 'Tue', label: 'Live, every week' },
];

const gets = [
  { num: '01', title: 'Build the skills live', desc: 'Every skill in the Field Kit gets built in a live lab. Watch it get scoped, prompted, and tested — then walk away with the working files.' },
  { num: '02', title: 'Scope the next one', desc: 'The next lab builds the landing-page skills. Members vote on scope and bring the use case they actually need solved.' },
  { num: '03', title: 'The room', desc: 'Operators, founders, and a few agency escapees shipping with Claude. Ask questions, share accounts, leave with a plan.' },
];

const members = [
  { quote: 'I came for the plugin. I stayed because watching the skill get built taught me more than the skill itself.', name: 'Maya R.', role: 'Growth lead · DTC apparel' },
  { quote: 'The pitch slot is wild — my use case got picked for the next lab. They\'re building it with me, live.', name: 'Jordan H.', role: 'CMO · Climate hardware' },
  { quote: 'Tuesdays are now my favorite work meeting and I\'m not even technical.', name: 'Alex S.', role: 'PM · Fintech' },
];

const schema = {
  '@type': 'Organization',
  name: 'The Vibe Marketers',
  description: 'A Skool community of marketers shipping with Claude, where every channel47 skill gets built live.',
  url: SKOOL_URL,
};
---

<BaseLayout
  title="Community — join the skills labs"
  description="The Vibe Marketers: a Skool community where every channel47 skill gets built live. Join the labs, scope the next skill, and ship with Claude."
  schema={schema}
>
  <Nav active="community" />

  <main id="main" class="wrap">
    <section class="hero" data-reveal-stagger>
      <div class="eyebrow hero__eyebrow" data-reveal-child style="--stagger: 0">The Vibe Marketers · led by James Dickerson</div>
      <h1 class="head-hero" data-reveal-child style="--stagger: 1">
        Join the room where every skill <span class="amber">actually</span> gets built.
      </h1>
      <p class="body-lead hero__sub" data-reveal-child style="--stagger: 2">
        A Skool community of marketers shipping with Claude. Every skill in the Field Kit is built live in a weekly lab — and members decide what gets built next.
      </p>
      <div class="hero__cta" data-reveal-child style="--stagger: 3">
        <a href={SKOOL_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">Join on Skool →</a>
        <a href="/plugin" class="btn-ghost">See what we've shipped</a>
        <span class="hero__cta-meta">$49/mo · cancel anytime</span>
      </div>
    </section>

    <div class="stats" data-reveal-stagger>
      {stats.map((s, i) => (
        <div class={`stat-cell ${i === stats.length - 1 ? 'is-last' : ''}`} data-reveal-child style={`--stagger: ${i}`}>
          <div class={`stat-cell__value ${s.amber ? 'is-amber' : ''}`}>{s.v}</div>
          <div class="stat-cell__label">{s.label}</div>
        </div>
      ))}
    </div>

    <section class="section-pad">
      <div class="eyebrow section__num" data-reveal>I — What you get</div>
      <h2 class="head-mid" data-reveal>
        You don't just get the skill. You see it <span class="amber">get built</span>.
      </h2>

      <div class="gets-grid" data-reveal-stagger>
        {gets.map((g, i) => (
          <div class="get-tile" data-reveal-child style={`--stagger: ${i}`}>
            <div class="get-tile__num">{g.num}</div>
            <h3 class="get-tile__title">{g.title}</h3>
            <p class="get-tile__desc">{g.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section-pad">
      <div class="eyebrow section__num" data-reveal>II — Inside the room</div>
      <h2 class="head-mid" data-reveal>
        Mostly operators. Some <span class="amber">founders</span>. A few escapees from holdco agencies.
      </h2>

      <div class="members-grid" data-reveal-stagger>
        {members.map((m, i) => (
          <figure class="member-card" data-reveal-child style={`--stagger: ${i}`}>
            <blockquote class="member-card__quote">&ldquo;{m.quote}&rdquo;</blockquote>
            <figcaption class="member-card__meta">
              <span class="member-card__name">{m.name}</span> · {m.role}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="join" data-reveal>
      <div class="eyebrow join__eyebrow">Join the labs</div>
      <h2 class="head-section join__head">
        The next lab builds the <span class="amber">landing-page</span> skills.
      </h2>
      <p class="body-mid join__sub">
        Page Writer, Section Builder, and Convert Check — built live, scoped by the room. Bring the page you need to ship.
      </p>
      <a href={SKOOL_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">Join on Skool →</a>
      <div class="join__lead">Led by James Dickerson · @boringmarketer</div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: clamp(80px, 10vw, 120px) clamp(24px, 5vw, 56px) 80px;
    border-bottom: 1px solid var(--color-line);
  }
  .hero__eyebrow { margin-bottom: 56px; }
  .hero__sub { margin-top: 56px; }
  .hero__cta {
    display: flex;
    gap: 16px;
    margin-top: 56px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero__cta-meta {
    font-size: 13px;
    color: var(--color-text-mute);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-left: 16px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--color-line);
  }
  .stat-cell { padding: 56px 36px; border-right: 1px solid var(--color-line); }
  .stat-cell.is-last { border-right: none; }
  .stat-cell__value {
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.04em;
    margin-bottom: 16px;
  }
  .stat-cell__value.is-amber { color: var(--color-amber); }
  .stat-cell__label {
    font-size: 11px;
    color: var(--color-text-mute);
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .section__num { margin-bottom: 56px; }

  .gets-grid {
    margin-top: 80px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-line);
  }
  .get-tile { background: var(--color-bg); padding: 40px 32px; min-height: 240px; }
  .get-tile__num {
    font-family: var(--font-family-mono);
    font-size: 14px;
    color: var(--color-amber);
    letter-spacing: 0.18em;
    margin-bottom: 24px;
  }
  .get-tile__title { font-size: 22px; letter-spacing: -0.015em; margin: 0 0 16px; }
  .get-tile__desc { font-size: 15px; line-height: 1.55; color: var(--color-text-dim); }

  .members-grid {
    margin-top: 80px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-line);
  }
  .member-card {
    background: var(--color-bg);
    padding: 40px 32px;
    min-height: 240px;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .member-card__quote {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.005em;
  }
  .member-card__meta {
    margin-top: auto;
    padding-top: 32px;
    font-size: 12px;
    color: var(--color-text-mute);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .member-card__name { color: var(--color-text); }

  .join {
    padding: clamp(100px, 14vw, 160px) clamp(24px, 5vw, 56px) clamp(120px, 18vw, 200px);
    text-align: center;
    border-bottom: 1px solid var(--color-line);
  }
  .join__eyebrow { margin-bottom: 48px; }
  .join__head { margin-inline: auto; max-width: 820px; }
  .join__sub { margin: 36px auto 56px; max-width: 560px; }
  .join__lead {
    font-size: 13px;
    color: var(--color-text-mute);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-top: 40px;
  }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat-cell:nth-child(2) { border-right: none; }
    .stat-cell:nth-child(1), .stat-cell:nth-child(2) { border-bottom: 1px solid var(--color-line); }
    .gets-grid { grid-template-columns: 1fr; }
    .members-grid { grid-template-columns: 1fr; }
  }
</style>
