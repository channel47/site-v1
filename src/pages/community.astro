---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const stats = [
  { v: '3,217', label: 'Members', amber: true },
  { v: '142', label: 'Sessions to date' },
  { v: '8', label: 'Plugins shipped from sessions' },
  { v: 'Tue', label: 'Live, every week' },
];

const calendar = [
  { date: 'Apr 16', day: 'Tue · 14:00', title: 'Funnel Architect — landing page from copy to code', plugin: 'S2 · E02', kind: 'now' },
  { date: 'Apr 23', day: 'Tue · 14:00', title: 'Funnel Architect — email sequence + Klaviyo handoff', plugin: 'S2 · E03', kind: 'next' },
  { date: 'Apr 30', day: 'Tue · 14:00', title: 'Office hours — bring your account, leave with a plan', plugin: 'Open', kind: 'next' },
  { date: 'May 7', day: 'Tue · 14:00', title: 'Media Buyer — pacing model walkthrough', plugin: 'S1 · Replay', kind: 'next' },
  { date: 'May 14', day: 'Tue · 14:00', title: 'Klaviyo Operator — kickoff (S3)', plugin: 'S3 · E01', kind: 'next' },
];

const members = [
  { quote: 'Cut my brief-to-launch from three weeks to four days. The Funnel Architect plugin is doing my job better than I did.', name: 'Maya R.', role: 'Growth lead · DTC apparel' },
  { quote: 'I sit in every session. Even when I don’t need the plugin, I learn how Brandon scopes the prompt.', name: 'Daniel V.', role: 'Solo founder · B2B SaaS' },
  { quote: 'The community matters more than the plugins. Honestly. The plugins are the excuse to be in the room.', name: 'Priya K.', role: 'Performance creative · Agency' },
  { quote: 'I came for ad creative. I left with a working email sequence and a Shopify cleanup pass I never would have shipped alone.', name: 'Tom A.', role: 'Brand owner · Coffee' },
  { quote: 'Tuesdays are now my favorite work meeting and I’m not even in marketing.', name: 'Alex S.', role: 'PM · Fintech' },
  { quote: 'The pitch slot is wild — my plugin idea got picked for S3. They’re building it for me. Live.', name: 'Jordan H.', role: 'CMO · Climate hardware' },
];
---

<BaseLayout
  title="Community — channel47"
  description="The Vibe Marketers — a 3,200-member Skool community where every channel47 plugin gets built live."
>
  <Nav active="community" />

  <main id="main" class="wrap">
    <section class="hero" data-reveal-stagger>
      <div class="eyebrow hero__eyebrow" data-reveal-child style="--stagger: 0">The Vibe Marketers · led by James Dickerson</div>
      <h1 class="head-hero" data-reveal-child style="--stagger: 1">
        The room where every plugin <span class="amber">actually</span> gets built.
      </h1>
      <p class="body-lead hero__sub" data-reveal-child style="--stagger: 2">
        A 3,200-member Skool community of marketers shipping with Claude. I mentor inside, run live sessions every Tuesday, and ship every plugin alongside the room.
      </p>
      <div class="hero__cta" data-reveal-child style="--stagger: 3">
        <a href="https://www.skool.com/the-vibe-marketers" target="_blank" rel="noopener noreferrer" class="btn-primary">Join on Skool →</a>
        <a href="/plugins/funnel-architect" class="btn-ghost">See a sample session</a>
        <span class="hero__cta-meta">$49/mo · cancel anytime</span>
      </div>
    </section>

    <div class="stats" data-reveal-stagger>
      {stats.map((s, i) => (
        <div class={`stat-cell ${i === stats.length - 1 ? 'is-last' : ''}`} data-reveal-child style={`--stagger: ${i}`}>
          <div class={`stat-cell__value ${s.amber ? 'is-amber' : ''}`}>{s.v}</div>
          <div class="stat-cell__label">{s.label}</div>
        </div>
      ))}
    </div>

    <section class="section-pad">
      <div class="eyebrow section__num" data-reveal>I — Sessions calendar</div>
      <h2 class="head-mid" data-reveal>
        Tuesdays at <span class="amber">14:00 PT</span>. Two hours, no filler.
      </h2>
      <p class="body-mid section__sub" data-reveal>
        One plugin per season, three sessions per plugin, plus open office hours. Recordings post next morning. Sessions run live on Skool — RSVP from inside the community.
      </p>

      <ul class="calendar" data-reveal-stagger>
        {calendar.map((c, i) => (
          <li class={`cal-row ${i === calendar.length - 1 ? 'is-last' : ''}`} data-reveal-child style={`--stagger: ${i}`}>
            <span class="cal-row__date">{c.date}</span>
            <span class="cal-row__day">{c.day}</span>
            <h3 class="cal-row__title">{c.title}</h3>
            <span class="cal-row__plugin">{c.plugin}</span>
            <a
              href="https://www.skool.com/the-vibe-marketers"
              target="_blank"
              rel="noopener noreferrer"
              class={`cal-row__rsvp ${c.kind === 'now' ? 'is-now' : ''}`}
            >
              {c.kind === 'now' ? 'Live now →' : 'RSVP →'}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-pad">
      <div class="eyebrow section__num" data-reveal>II — Inside the room</div>
      <h2 class="head-mid" data-reveal>
        Mostly operators. Some <span class="amber">founders</span>. A few escapees from holdco agencies.
      </h2>

      <div class="members-grid" data-reveal-stagger>
        {members.map((m, i) => (
          <figure class="member-card" data-reveal-child style={`--stagger: ${i % 6}`}>
            <blockquote class="member-card__quote">&ldquo;{m.quote}&rdquo;</blockquote>
            <figcaption class="member-card__meta">
              <span class="member-card__name">{m.name}</span> · {m.role}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="lead-block" data-reveal>
      <div>
        <div class="eyebrow">The room is led by</div>
        <h2 class="lead-block__name">James <span class="amber">Dickerson</span></h2>
        <div class="lead-block__handle">@boringmarketer · Skool host</div>
      </div>
      <p class="lead-block__copy">
        James runs the day-to-day inside The Vibe Marketers — moderates the room, books the calendar, keeps the standard high. I bring the plugins; James brings the community. The two of us make the sessions happen, every Tuesday.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: clamp(80px, 10vw, 120px) clamp(24px, 5vw, 56px) 80px;
    border-bottom: 1px solid var(--color-line);
  }
  .hero__eyebrow { margin-bottom: 56px; }
  .hero__sub { margin-top: 56px; }
  .hero__cta {
    display: flex;
    gap: 16px;
    margin-top: 56px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero__cta-meta {
    font-size: 13px;
    color: var(--color-text-mute);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-left: 16px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--color-line);
  }
  .stat-cell {
    padding: 56px 36px;
    border-right: 1px solid var(--color-line);
  }
  .stat-cell.is-last { border-right: none; }
  .stat-cell__value {
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.04em;
    margin-bottom: 16px;
  }
  .stat-cell__value.is-amber { color: var(--color-amber); }
  .stat-cell__label {
    font-size: 11px;
    color: var(--color-text-mute);
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .section__num { margin-bottom: 56px; }
  .section__sub { margin-top: 40px; }

  .calendar {
    list-style: none;
    margin: 80px 0 0;
    padding: 0;
  }
  .cal-row {
    display: grid;
    grid-template-columns: 120px 80px 1fr 160px 120px;
    gap: 32px;
    padding: 32px 0;
    border-top: 1px solid var(--color-line);
    align-items: center;
  }
  .cal-row.is-last { border-bottom: 1px solid var(--color-line); }
  .cal-row__date {
    font-family: var(--font-family-mono);
    font-size: 14px;
    color: var(--color-text);
    letter-spacing: 0.04em;
  }
  .cal-row__day {
    font-size: 12px;
    color: var(--color-text-mute);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .cal-row__title {
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  .cal-row__plugin {
    font-size: 12px;
    color: var(--color-text-mute);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .cal-row__rsvp {
    font-size: 12px;
    color: var(--color-amber);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    border: 1px solid var(--color-amber);
    padding: 8px 14px;
    background: transparent;
    cursor: pointer;
    text-align: center;
    transition: background var(--dur-instant);
  }
  .cal-row__rsvp:hover { background: rgba(245, 181, 68, 0.1); }
  .cal-row__rsvp.is-now { background: rgba(245, 181, 68, 0.12); }

  .members-grid {
    margin-top: 80px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-line);
  }
  .member-card {
    background: var(--color-bg);
    padding: 40px 32px;
    min-height: 240px;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .member-card__quote {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.005em;
  }
  .member-card__meta {
    margin-top: auto;
    padding-top: 32px;
    font-size: 12px;
    color: var(--color-text-mute);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .member-card__name { color: var(--color-text); }

  .lead-block {
    padding: clamp(100px, 14vw, 160px) clamp(24px, 5vw, 56px) clamp(120px, 18vw, 200px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    border-bottom: 1px solid var(--color-line);
  }
  .lead-block__name {
    font-size: clamp(56px, 8vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    margin-top: 24px;
  }
  .lead-block__handle {
    font-size: 14px;
    color: var(--color-text-mute);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 24px;
  }
  .lead-block__copy {
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.6;
    color: var(--color-text-dim);
  }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat-cell:nth-child(2) { border-right: none; }
    .stat-cell:nth-child(1), .stat-cell:nth-child(2) { border-bottom: 1px solid var(--color-line); }

    .cal-row {
      grid-template-columns: 100px 1fr;
      gap: 16px;
      padding: 24px 0;
    }
    .cal-row__day, .cal-row__plugin, .cal-row__rsvp {
      grid-column: 2;
      justify-self: start;
    }
    .cal-row__rsvp { margin-top: 8px; }

    .members-grid { grid-template-columns: 1fr; }

    .lead-block {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
