---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const services = [
  { idx: '01', name: 'Marketing systems, end-to-end', desc: 'Site, email, ads, automation — scoped, built, handed off as a system you can run yourself.', price: 'From $24k' },
  { idx: '02', name: 'Shopify storefronts & flows', desc: 'Themes, checkouts, and Klaviyo flows for brands moving real product. Two-week sprints.', price: 'From $9k' },
  { idx: '03', name: 'Performance creative & ads', desc: 'Hook research, creative production, and account ops on Meta and Google. Monthly retainer.', price: '$6k/mo', amber: true },
  { idx: '04', name: 'Agent-powered retainers', desc: 'Ongoing build with Claude Code. Weekly drops, written specs, real ownership.', price: '$8k/mo' },
];

const cases = [
  { tag: '01 · Shopify · DTC apparel', client: 'Halftone & Co.', desc: 'Replatformed from a custom Webflow site to a Shopify build with a Klaviyo welcome flow and a paid-social creative engine.', stats: [{ v: '+38%', l: 'Conversion' }, { v: '4 wk', l: 'Build time' }] },
  { tag: '02 · System · B2B SaaS', client: 'Northroom', desc: 'Built a content-to-pipeline system: weekly publishing pipeline, MQL scoring, and a sales-enablement plugin.', stats: [{ v: '3.1x', l: 'MQL volume' }, { v: '8 wk', l: 'Build time' }] },
  { tag: '03 · Performance · Coffee', client: 'Forty Beans', desc: 'Hook research, weekly creative drops, and a pacing model that runs across Meta and Google. Now a 6-month retainer.', stats: [{ v: '−24%', l: 'CAC' }, { v: '12 mo', l: 'On retainer' }] },
  { tag: '04 · Klaviyo · Cosmetics', client: 'Lumen Studio', desc: 'Lifecycle rebuild — new welcome, post-purchase, and winback flows generated from review-mining and a tone-of-voice doc.', stats: [{ v: '+62%', l: 'Email rev' }, { v: '2 wk', l: 'Build time' }] },
];

const process = [
  { num: '01', title: 'Brief', desc: 'One call, one written brief. We agree on the system, the deliverables, and the timeline before I write a line of code.' },
  { num: '02', title: 'Spec', desc: 'I write a public spec — pages, flows, prompts, and the agent setup. You sign off on the spec, not on vibes.' },
  { num: '03', title: 'Build', desc: 'Claude Code does most of the typing. I do the strategy, the review, and the integration. Daily Loom updates.' },
  { num: '04', title: 'Handoff', desc: 'You get the working system, written runbooks, and a recorded walkthrough. Optional retainer to keep shipping.' },
];
---

<BaseLayout
  title="Studio — channel47"
  description="Marketing systems for small businesses, built with agents. Site, email, ads, automation — scoped, built, handed off."
>
  <a href="#main" class="skip-link">Skip to content</a>
  <Nav active="studio" />

  <main id="main" class="wrap">
    <section class="hero">
      <div class="eyebrow hero__eyebrow">channel47 studio · client work</div>
      <h1 class="head-hero">
        Marketing systems for small businesses, built with <span class="amber">agents</span>.
      </h1>
      <p class="body-lead hero__sub">
        A small client roster, three to five engagements at a time. Biased toward Shopify and physical-goods brands — open to anything I can ship cleanly.
      </p>
      <div class="hero__cta">
        <a href="#contact" class="btn-primary">Book an intro call →</a>
        <a href="#cases" class="btn-ghost">See recent work</a>
      </div>
    </section>

    <section class="section-pad">
      <div class="eyebrow section__num">I — Services</div>
      <h2 class="head-mid">
        Four ways to <span class="amber">work together</span>.
      </h2>

      <ul class="services">
        {services.map((s, i) => (
          <li class={`service-row ${i === services.length - 1 ? 'is-last' : ''}`}>
            <span class="service-row__idx">{s.idx}</span>
            <h3 class="service-row__name">{s.name}</h3>
            <p class="service-row__desc">{s.desc}</p>
            <span class={`service-row__price ${s.amber ? 'is-amber' : ''}`}>{s.price}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-pad" id="cases">
      <div class="eyebrow section__num">II — Recent work</div>
      <h2 class="head-mid">
        Four engagements, <span class="amber">shipped</span>.
      </h2>

      <div class="case-grid">
        {cases.map((c) => (
          <article class="case-card">
            <div class="case-card__tag">{c.tag}</div>
            <h3 class="case-card__client">{c.client}</h3>
            <p class="case-card__desc">{c.desc}</p>
            <div class="case-card__results">
              {c.stats.map((s) => (
                <div class="case-card__stat">
                  <div class="case-card__stat-val">{s.v}</div>
                  <div class="case-card__stat-label">{s.l}</div>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-pad">
      <div class="eyebrow section__num">III — How it works</div>
      <h2 class="head-mid">
        Scope to ship in <span class="amber">four steps</span>.
      </h2>

      <div class="process">
        {process.map((p) => (
          <div class="process-step">
            <div class="process-step__num">{p.num}</div>
            <h3 class="process-step__title">{p.title}</h3>
            <p class="process-step__desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="eyebrow contact__eyebrow">IV — Get in touch</div>
      <h2 class="contact__head">
        One slot opens up roughly every <span class="amber">six weeks</span>.
      </h2>
      <p class="contact__sub">
        Drop your email and a sentence about what you're building. I read everything; I reply within a day.
      </p>
      <form class="nl-form contact__form" data-kit-form data-tag="studio">
        <input type="email" name="email" placeholder="you@studio.com" required aria-label="Email address" />
        <button type="submit">Send →</button>
      </form>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: clamp(80px, 10vw, 120px) clamp(24px, 5vw, 56px) clamp(60px, 8vw, 100px);
    border-bottom: 1px solid var(--color-line);
  }
  .hero__eyebrow { margin-bottom: 56px; }
  .hero__sub { margin-top: 56px; }
  .hero__cta {
    display: flex;
    gap: 16px;
    margin-top: 56px;
    flex-wrap: wrap;
  }

  .section__num { margin-bottom: 56px; }

  .services {
    list-style: none;
    margin: 80px 0 0;
    padding: 0;
  }
  .service-row {
    display: grid;
    grid-template-columns: 60px 1fr 1fr 200px;
    gap: 48px;
    padding: 40px 0;
    border-top: 1px solid var(--color-line);
    align-items: baseline;
  }
  .service-row.is-last { border-bottom: 1px solid var(--color-line); }
  .service-row__idx {
    font-size: 13px;
    color: var(--color-text-mute);
    letter-spacing: 0.12em;
  }
  .service-row__name {
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .service-row__desc {
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-text-dim);
  }
  .service-row__price {
    font-size: 13px;
    color: var(--color-text-mute);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: right;
  }
  .service-row__price.is-amber {
    color: var(--color-amber);
    font-weight: 600;
  }

  .case-grid {
    margin-top: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-line);
  }
  .case-card {
    background: var(--color-bg);
    padding: 48px 40px;
    min-height: 360px;
    display: flex;
    flex-direction: column;
  }
  .case-card__tag {
    font-size: 11px;
    color: var(--color-text-mute);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }
  .case-card__client {
    font-size: clamp(24px, 2.6vw, 32px);
    letter-spacing: -0.025em;
    margin: 0 0 16px;
  }
  .case-card__desc {
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-text-dim);
    max-width: 480px;
  }
  .case-card__results {
    margin-top: auto;
    padding-top: 40px;
    display: flex;
    gap: 40px;
    border-top: 1px solid var(--color-line-soft);
  }
  .case-card__stat-val {
    font-size: 28px;
    color: var(--color-amber);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }
  .case-card__stat-label {
    font-size: 11px;
    color: var(--color-text-mute);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .process {
    margin-top: 80px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-line);
  }
  .process-step {
    background: var(--color-bg);
    padding: 40px 32px;
    min-height: 220px;
  }
  .process-step__num {
    font-family: var(--font-family-mono);
    font-size: 14px;
    color: var(--color-amber);
    letter-spacing: 0.18em;
    margin-bottom: 24px;
  }
  .process-step__title {
    font-size: 22px;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
  }
  .process-step__desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-dim);
  }

  .contact {
    padding: clamp(120px, 16vw, 160px) clamp(24px, 5vw, 56px) clamp(140px, 20vw, 200px);
    text-align: center;
    border-bottom: 1px solid var(--color-line);
  }
  .contact__eyebrow { margin-bottom: 56px; }
  .contact__head {
    font-size: clamp(48px, 8vw, 88px);
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 980px;
    margin-inline: auto;
  }
  .contact__sub {
    font-size: clamp(17px, 1.7vw, 19px);
    color: var(--color-text-dim);
    margin: 32px auto 56px;
    max-width: 540px;
  }
  .contact__form {
    max-width: 540px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .service-row {
      grid-template-columns: 40px 1fr;
      gap: 16px;
      padding: 32px 0;
    }
    .service-row__desc, .service-row__price {
      grid-column: 2;
    }
    .service-row__price { text-align: left; }
    .case-grid { grid-template-columns: 1fr; }
    .process { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .process { grid-template-columns: 1fr; }
  }
</style>
