---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SKOOL_URL } from '../consts';

// The whole site in four doors. Each row is one clear next step.
const paths = [
  { idx: '01', name: 'The plugin', desc: 'Field Kit — small marketing skills that chain from customer research to a landing page.', href: '/plugin', cta: 'See the skills', external: false },
  { idx: '02', name: 'The labs', desc: 'Join The Vibe Marketers on Skool and help build the next skill live.', href: SKOOL_URL, cta: 'Join on Skool', external: true },
  { idx: '03', name: 'The newsletter', desc: 'Plugin drops and session notes. Roughly twice a month, no filler.', href: '/subscribe', cta: 'Subscribe', external: false },
  { idx: '04', name: 'Work with me', desc: 'Need the system built for you? Tell me what you\'re shipping.', href: '/contact', cta: 'Get in touch', external: false },
];

const schema = [
  { '@type': 'WebSite', name: 'channel47', url: 'https://channel47.dev/' },
  {
    '@type': 'Organization',
    name: 'channel47',
    url: 'https://channel47.dev/',
    logo: 'https://channel47.dev/logo-square.png',
    sameAs: ['https://x.com/ctrlswing', 'https://github.com/ctrlswing', 'https://linkedin.com/in/ctrlswing'],
  },
];
---

<BaseLayout
  title="channel47 — marketing skills, built live, shipped as one plugin"
  description="channel47 builds small, sharp marketing skills live in the skills labs and ships them as one Claude Code plugin: customer research, personas, angles, and the landing page they feed."
  schema={schema}
>
  <Nav active="home" />

  <main id="main" class="wrap">
    <section class="hero" data-reveal-stagger>
      <div class="eyebrow hero__eyebrow" data-reveal-child style="--stagger: 0">channel47 — est. 2024</div>
      <h1 class="head-hero" data-reveal-child style="--stagger: 1">
        Marketing skills, built <span class="amber">live</span>, shipped as one plugin.
      </h1>
      <p class="body-lead hero__body" data-reveal-child style="--stagger: 2">
        Each skill gets built in the open inside a live lab, then dropped into the Field Kit plugin — customer research, personas, angles, and the landing page they feed.
      </p>
    </section>

    <ul class="paths" data-reveal-stagger>
      {paths.map((p, i) => (
        <li class={`path-row ${i === paths.length - 1 ? 'is-last' : ''}`} data-reveal-child style={`--stagger: ${i}`}>
          <a
            href={p.href}
            class="path-row__link"
            {...(p.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="path-row__idx">{p.idx}</span>
            <div class="path-row__body">
              <h2 class="path-row__name">{p.name}</h2>
              <p class="path-row__desc">{p.desc}</p>
            </div>
            <span class="path-row__cta">{p.cta} →</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: clamp(72px, 9vw, 120px) clamp(24px, 5vw, 56px) clamp(72px, 9vw, 120px);
    border-bottom: 1px solid var(--color-line);
  }
  .hero__eyebrow { margin-bottom: 48px; }
  .hero__body { margin-top: 48px; }

  .paths { list-style: none; margin: 0; padding: 0; }
  .path-row { border-bottom: 1px solid var(--color-line); }
  .path-row__link {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr 180px;
    gap: 40px;
    padding: 48px clamp(24px, 5vw, 56px);
    align-items: baseline;
    transition: background var(--dur-quick);
  }
  .path-row__link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-amber);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--dur-quick) var(--ease-out);
  }
  .path-row__link:hover { background: rgba(245, 181, 68, 0.025); }
  .path-row__link:hover::before { transform: scaleY(1); }
  .path-row__link:hover .path-row__name { color: var(--color-amber); }
  .path-row__idx {
    font-family: var(--font-family-mono);
    font-size: 13px;
    color: var(--color-text-mute);
    letter-spacing: 0.12em;
  }
  .path-row__name {
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0 0 14px;
    transition: color var(--dur-quick);
  }
  .path-row__desc {
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-text-dim);
    max-width: 520px;
  }
  .path-row__cta {
    font-size: 12px;
    color: var(--color-amber);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: right;
    justify-self: end;
  }

  @media (max-width: 720px) {
    .path-row__link {
      grid-template-columns: 36px 1fr;
      gap: 20px;
      padding: 36px 24px;
    }
    .path-row__cta { grid-column: 2; justify-self: start; text-align: left; margin-top: 12px; }
  }
</style>
