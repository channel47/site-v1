# Kit (ConvertKit) — required for the /api/subscribe and /api/request-build forms.
# Generate a V4 API key in the Kit dashboard: Settings → Developer → API Keys.
# Set this in .env.local for local dev, and in the Vercel project's Environment Variables for production.
KIT_API_KEY=

# Optional — /api/subscribe upgrades when these are set:
#   KIT_FORM_ID        adds the subscriber to a form (runs that form's opt-in/confirmation flow)
#   KIT_WARM_TAG_ID    tags warm (not-yet-member) email leads
#   KIT_MEMBER_TAG_ID  tags code-redeeming members
# Without KIT_FORM_ID the subscriber is created but not placed on any form/sequence.
KIT_FORM_ID=
KIT_WARM_TAG_ID=
KIT_MEMBER_TAG_ID=
