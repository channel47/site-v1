# Kit (ConvertKit) — required for /api/subscribe and the newsletter CLI.
# Generate a V4 API key in the Kit dashboard: Settings → Developer → API Keys.
# Set this in .env.local for local dev, and in the Vercel project's Environment Variables for production.
KIT_API_KEY=

# Optional — /api/subscribe routing upgrades when these are set. They do not
# define the broadcast audience; Channel47 emails target all active subscribers.
#   KIT_FORM_ID        adds the subscriber to a form (runs that form's opt-in/confirmation flow)
#   KIT_WARM_TAG_ID    tags warm (not-yet-member) email leads
#   KIT_MEMBER_TAG_ID  tags code-redeeming members
# Without KIT_FORM_ID the subscriber is created but not placed on any form/sequence.
KIT_FORM_ID=
KIT_WARM_TAG_ID=
KIT_MEMBER_TAG_ID=

# Statsig — client key provisioned by the Vercel Marketplace integration.
# Custom events run on channel47.dev in production only by default.
NEXT_PUBLIC_STATSIG_CLIENT_KEY=
# Explicit local/preview verification goes to Statsig's development environment.
# Leave unset for ordinary development and never enable to collect production data.
NEXT_PUBLIC_MEASUREMENT_TEST=
